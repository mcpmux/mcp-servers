  },
  "contributor": {
    "name": "Verateca",
    "github": "Verateca-team",
    "url": "https://verateca.com"
  },
  "links": {
    "repository": "https://github.com/Verateca/Verateca-mcp",
    "homepage": "https://verateca.com",
    "documentation": "https://verateca.com/ai"
  },
  "platforms": [
    "all"
  ],
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false,
    "read_only_mode": true
  }
