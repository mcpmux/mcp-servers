{
  "$schema": "../schemas/server-definition.schema.json",
  "id": "ch.datenkraft-apple-productivity-mcp-npx",
  "name": "Apple Productivity MCP (npx)",
  "alias": "apple-productivity",
  "description": "133 local macOS tools across 17 groups for Apple apps, iWork documents, files, and media, plus optional allowlisted Shortcuts.",
  "logo": "https://avatars.githubusercontent.com/u/106869358?v=4",
  "schema_version": "2.1",
  "categories": [
    "productivity",
    "communication",
    "file-system"
  ],
  "tags": [
    "apple",
    "macos",
    "mail",
    "calendar",
    "reminders",
    "iwork",
    "files",
    "shortcuts"
  ],
  "transport": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@gambadio/apple-productivity-mcp@latest"
    ],
    "metadata": {
      "inputs": []
    }
  },
  "auth": {
    "type": "none",
    "instructions": "Runs locally on macOS with Node.js 20+; no server account or API key is required. Install and configure the Apple apps you want to use, and grant the launching MCP client/process macOS Automation permission when prompted. Generic file tools need configured file roots; running Shortcuts requires an explicit allowlist (see documentation)."
  },
  "contributor": {
    "name": "Ricardo Kupper",
    "github": "gambadio",
    "url": "https://datenkraft.ch"
  },
  "links": {
    "repository": "https://github.com/gambadio/apple-productivity-mcp",
    "homepage": "https://datenkraft.ch",
    "documentation": "https://github.com/gambadio/apple-productivity-mcp#readme"
  },
  "platforms": [
    "macos"
  ],
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false,
    "read_only_mode": false
  },
  "changelog_url": "https://github.com/gambadio/apple-productivity-mcp/releases"
}
