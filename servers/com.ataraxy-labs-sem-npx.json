{
  "$schema": "../schemas/server-definition.schema.json",
  "schema_version": "2.1",
  "id": "com.ataraxy-labs-sem-npx",
  "name": "Sem",
  "alias": "sem",
  "description": "Search code entities, inspect callers and dependencies, and review structural changes in a local Git repository.",
  "logo": "https://avatars.githubusercontent.com/u/235773868?v=4",
  "categories": ["developer-tools", "version-control"],
  "tags": ["code", "git", "entities", "callers", "diff", "local"],
  "transport": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@ataraxy-labs/sem@0.27.0", "mcp"],
    "env": {
      "SEM_REPO": "${input:SEM_REPO}",
      "SEM_NO_NETWORK": "1",
      "SEM_NO_TELEMETRY": "1"
    },
    "metadata": {
      "inputs": [{
        "id": "SEM_REPO",
        "label": "Git repository",
        "description": "Absolute path to an existing, trusted local Git repository. Validation tools can execute repository build/test commands; this path is not a security sandbox.",
        "type": "directory_path",
        "required": true,
        "secret": false,
        "placeholder": "/absolute/path/to/repository"
      }]
    }
  },
  "auth": {
    "type": "none",
    "instructions": "No API key is needed; Node.js/npm and Git are required. Initial installation downloads the native binary; Sem cloud access and telemetry are disabled by this preset. Only connect trusted repositories."
  },
  "contributor": {
    "name": "Rohan Sharma",
    "github": "rs545837",
    "url": "https://github.com/rs545837"
  },
  "links": {
    "repository": "https://github.com/Ataraxy-Labs/sem",
    "homepage": "https://ataraxy-labs.com",
    "documentation": "https://github.com/Ataraxy-Labs/sem/tree/v0.27.0#use-with-ai-agents-mcp"
  },
  "changelog_url": "https://github.com/Ataraxy-Labs/sem/releases",
  "platforms": ["macos", "linux"],
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false,
    "read_only_mode": false
  }
}
