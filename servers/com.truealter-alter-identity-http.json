  "schema_version": "2.1",
  "categories": [
    "security",
    "ai-ml"
  ],
  "tags": [
    "identity",
    "psychometrics",
    "privacy",
    "remote",
    "streamable-http"
  ],
  "transport": {
    "type": "http",
    "url": "https://mcp.truealter.com/api/v1/mcp",
    "metadata": {
      "inputs": []
    }
  },
  "auth": {
    "type": "none"
  },
  "contributor": {
    "name": "~Alter",
    "github": "true-alter",
    "url": "https://truealter.com"
  },
  "links": {
    "repository": "https://github.com/true-alter/cli",
    "homepage": "https://truealter.com",
    "documentation": "https://truealter.com/docs/mcp/tools"
  },
  "platforms": [
    "all"
  ],
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": false,
    "read_only_mode": false
  }
}
